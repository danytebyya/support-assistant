# scripts/start.sh/start.ps1 override this automatically for the current OS.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
CHROMA_PATH=/app/data/chroma
KNOWLEDGE_PATH=/app/data/knowledge/faq.json
LOG_PATH=/app/data/logs/chat.jsonl
# Security settings (change for production!)
ALLOWED_ORIGINS=https://limehd.tv,https://*.limehd.tv
TRUST_PROXY=false
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
MAX_MESSAGE_LENGTH=1000
TOP_K=4
MIN_RELEVANCE=0.24
DIRECT_ANSWER_RELEVANCE=0.65
ADMIN_TOKEN=generate-a-strong-random-token-here
