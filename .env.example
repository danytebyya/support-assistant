# Production environment template for Support project
OLLAMA_URL=http://ollama:11434
# For 4GB RAM servers use: qwen2.5:3b (~2GB) — good quality/size balance
# For tighter RAM budgets use: qwen2.5:1.5b (~1GB, less accurate)
# For 8GB+ RAM servers use: qwen3:8b (~5GB, best quality, Apple Silicon)
OLLAMA_CHAT_MODEL=qwen2.5:3b
# Embedding models:
#   Server (CPU, low RAM): nomic-embed-text (274MB) or all-minilm (120MB)
#   Mac / good hardware:   bge-m3 (1.2GB) — best multilingual/Russian quality
OLLAMA_EMBED_MODEL=nomic-embed-text
CHROMA_PATH=/app/data/chroma
KNOWLEDGE_PATH=/app/data/knowledge/faq.json
LOG_PATH=/app/data/logs/chat.jsonl

# Security & CORS settings
# Set ALLOWED_ORIGINS to * or specific domains (e.g., http://SERVER_IP:8080)
ALLOWED_ORIGINS=*
TRUST_PROXY=true
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
MAX_MESSAGE_LENGTH=1000
TOP_K=4
MIN_RELEVANCE=0.24
# Tune per embedding model: nomic-embed-text -> 0.80, bge-m3 -> 0.60, all-minilm -> 0.50
DIRECT_ANSWER_RELEVANCE=0.80

# Admin Token for reindexing API (/admin/reindex)
ADMIN_TOKEN=change-this-to-a-secure-random-token
